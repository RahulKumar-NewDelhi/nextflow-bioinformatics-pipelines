process {

    withLabel: trimgalore {
        container = 'quay.io/biocontainers/trim-galore:0.6.7--hdfd78af_0'
    }

    withLabel: fastqc {
        container = 'quay.io/biocontainers/fastqc:0.11.9--hdfd78af_1'
    }

    withLabel: bwa {
        container = 'quay.io/biocontainers/bwa:0.7.3a--h5bf99c6_6'
    }

    withLabel: samtools {
        container = 'docker.io/commander121/alignment-tools:1.13d-b1'
    }

    withLabel: bedtools {
        container = 'quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_1'
    }

    withLabel: bcftools {
        container = 'docker.io/commander121/alignment-tools:1.13d-b1'
    }

    withLabel: snpeff {
        container = 'docker.io/commander121/snpeff:5.1d-b1'
    }

    withLabel: gatk {
        container = 'docker.io/broadinstitute/gatk:4.2.6.1'
    }

    withLabel: genebe {
        container = 'genebe/pygenebe:0.1.15'
    }

    withLabel: nanoplot {
        container = 'quay.io/biocontainers/nanoplot:1.42.0--pyhdfd78af_0'
    }

    withLabel: python3 {
        container = 'docker.io/commander121/biopython:1.76d-b3'
    }

    withLabel: umi_ont {
        container = 'quay.io/genepi/umi-pipeline-nf:v1.0.1'
    }

    withLabel: rmarkdown {
       container = 'docker.io/commander121/rmarkdown:4.4.0d-p_b1'
    }
}

dag {
    overwrite = true
    enabled = true
    file = 'workflow.png'
}

trace {
    overwrite = true
    enabled = true
    file = 'pipeline_trace.txt'
}

profiles {
    singularity {
        singularity.runOptions = "--bind /mnt,/media"
        singularity.enabled = true 
        singularity.autoMounts = true
	    singularity.cacheDir = "$HOME/.singularity"
    }

    docker {    
        docker.enabled = true    
        docker.temp = 'auto'    
        docker.fixOwnership = true    
        docker.runOptions = "-u `id -u`:`id -g` -v $HOME:$HOME -v /mnt:/mnt -v /media:/media -v /opt/Commander-AI:/opt/Commander-AI"
    }

    podman {
        podman.enabled = true
        podman.runOptions = '-v $HOME:$HOME -v /mnt:/mnt -v /media:/media -v /opt/Commander-AI:/opt/Commander-AI'
    }
}
